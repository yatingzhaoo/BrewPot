{
  "name": "brewpot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:agents": "python3 scripts/build-agents.py",
    "build": "npm run build:agents && vite build && node scripts/finalize-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test:build": "node scripts/test-build.mjs"
  },
  "dependencies": {
    "iconsax-react": "^0.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.4",
    "gh-pages": "^6.3.0",
    "playwright": "^1.55.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  }
}
